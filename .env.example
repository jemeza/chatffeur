# Copy to .env and fill in values

# Anthropic API key (required)
ANTHROPIC_API_KEY=sk-ant-...

# Platform selection: "mock" | "uber" | "lyft"
RIDE_PLATFORM=mock

# Uber credentials (only needed if RIDE_PLATFORM=uber)
UBER_CLIENT_ID=
UBER_CLIENT_SECRET=
UBER_SERVER_TOKEN=

# Lyft credentials (only needed if RIDE_PLATFORM=lyft)
LYFT_CLIENT_ID=
LYFT_CLIENT_SECRET=

# SQLite log database path (default: chatffeur.db)
LOG_DB_PATH=chatffeur.db
