# Copy this file to .env and fill in your values
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Uber for Business Guest Rides API credentials
# Obtain from https://developer.uber.com/ under your Uber for Business app
UBER_CLIENT_ID=your_uber_client_id
UBER_CLIENT_SECRET=your_uber_client_secret

# Set to "false" to use the production API (real rides, real charges)
# Defaults to "true" (sandbox) for safe development and testing
UBER_SANDBOX=true
